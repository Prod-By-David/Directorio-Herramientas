NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ===== STRIPE · MODO PRUEBA =====
# Usa SOLO claves del modo test de Stripe (sk_test_..., pk_test_..., whsec_ del endpoint/CLI de test).
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Mientras no sea exactamente "true", el código RECHAZA claves sk_live_ e ignora eventos live.
# Cambiarlo es decisión del responsable, cuando se vaya a vender.
ALLOW_LIVE_PAYMENTS="false"

# ===== RUTA / URL =====
# Opcional. Déjalo VACÍO en local y en GitHub Codespaces: se detecta de la petición.
# En producción, tu dominio con https (p. ej. https://midirectorio.com).
NEXT_PUBLIC_SITE_URL=""

# ===== ADMINISTRACIÓN =====
# Emails (separados por comas) con acceso a /admin. Vacío = nadie es admin.
ADMIN_EMAILS=""

# ===== CRON (caducidad de destacados) =====
# Secreto largo y aleatorio; Vercel Cron lo envía como "Authorization: Bearer <valor>".
CRON_SECRET=""

